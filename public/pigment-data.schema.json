{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chroma measured pigment calibration v1",
  "type": "object",
  "required": [
    "version",
    "basis",
    "calibration",
    "pigments"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "basis": {
      "const": "volume"
    },
    "calibration": {
      "type": "string",
      "pattern": "\\S"
    },
    "pigments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "material",
          "source",
          "license",
          "wavelengths",
          "K",
          "S"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "material": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "license": {
            "type": "string",
            "pattern": "\\S"
          },
          "wavelengths": {
            "const": [
              380,
              390,
              400,
              410,
              420,
              430,
              440,
              450,
              460,
              470,
              480,
              490,
              500,
              510,
              520,
              530,
              540,
              550,
              560,
              570,
              580,
              590,
              600,
              610,
              620,
              630,
              640,
              650,
              660,
              670,
              680,
              690,
              700,
              710,
              720,
              730,
              740,
              750
            ]
          },
          "K": {
            "type": "array",
            "minItems": 38,
            "maxItems": 38,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "S": {
            "type": "array",
            "minItems": 38,
            "maxItems": 38,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
